{
  "name": "@element-hq/element-web-module-api",
  "type": "module",
  "version": "2.3.0",
  "description": "Module API surface for element-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-hq/element-web.git",
    "directory": "packages/module-api"
  },
  "author": "element-hq",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./lib/element-web-module-api-alpha.d.ts",
  "exports": {
    ".": {
      "types": "./lib/element-web-module-api-alpha.d.ts",
      "import": "./lib/element-web-plugin-engine.js",
      "require": "./lib/element-web-plugin-engine.umd.cjs"
    },
    "./vite.base.ts": {
      "types": "./vite.base.ts",
      "import": "./vite.base.ts"
    }
  },
  "files": [
    "lib",
    "vite.base.ts"
  ],
  "devDependencies": {
    "@microsoft/api-extractor": "^7.49.1",
    "@types/node": "ts6.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.5.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "matrix-widget-api": "^1.17.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "semver": "^7.6.3",
    "shared-types": "0.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "matrix-web-i18n": "*",
    "matrix-widget-api": "*",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "matrix-widget-api": {
      "optional": true
    },
    "matrix-web-i18n": {
      "optional": true
    }
  },
  "scripts": {
    "lint:types": "nx lint:types",
    "test:unit": "vitest",
    "coverage": "pnpm test:unit --coverage",
    "coverage:diff": "diff-cover --config-file ../../diff-cover.toml coverage/lcov.info"
  }
}