.mx_MLocationBody {
    max-width: 100%;

    .mx_MLocationBody_map {
        max-width: 100%;
        width: 450px;
        height: 300px;
        z-index: 0; /* keeps the entire map under the message action bar */

        border-radius: var(--MBody-border-radius);
        cursor: pointer;
    }
}

/* Location maps use the full event-line width instead of the text-body gutter. */
.mx_EventTile_line .mx_MLocationBody {
    --event-tile-content-inline-end: 0;
}

/* In the timeline, we fit the width of the container */
.mx_EventTile_line .mx_MLocationBody .mx_MLocationBody_map {
    max-width: 450px;
    width: 100%;
}

/* Bubble lines use shrink-to-fit sizing. Give the map an intrinsic width
   before constraining it to the available bubble width. */
.mx_EventTile_line .mx_MLocationBody_bubble .mx_MLocationBody_map {
    max-width: 100%;
    width: 450px;
}

/* EventTileView places the sender and body in separate slot boundaries. */
.mx_EventTile > :has(> .mx_DisambiguatedProfile) ~ .mx_EventTile_line .mx_MLocationBody {
    margin-top: 6px; /* See: https://github.com/matrix-org/matrix-react-sdk/pull/8442 */
}
